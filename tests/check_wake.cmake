# M24.7: waking up. Every pinned age is deterministic and different, a finished wake is the
# settled menu byte for byte, a shut eyelid is pure black, the glow through the lids is
# dim but present, and the lab-off launch never sees any of it.
file(MAKE_DIRECTORY "${OUT_DIR}/wake")
set(W 96)
set(H 54)
function(shot name)
  execute_process(COMMAND "${GUI}" --theme manifold --width ${W} --height ${H} ${ARGN}
    --shot "${OUT_DIR}/wake/${name}.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name} capture failed: ${err}")
  endif()
  file(SHA256 "${OUT_DIR}/wake/${name}.ppm" h)
  set(hash_${name} ${h} PARENT_SCOPE)
endfunction()
# Sum and maximum of every colour byte in rows [y0, y1) of a binary P6 capture whose header
# is "P6\n<W> <H>\n255\n".
function(rows file y0 y1 out_sum out_max)
  file(READ "${file}" hex HEX)
  string(LENGTH "P6\n${W} ${H}\n255\n" header)
  math(EXPR first "(${header} + ${y0} * ${W} * 3) * 2")
  math(EXPR last "(${header} + ${y1} * ${W} * 3) * 2 - 2")
  set(sum 0)
  set(max 0)
  foreach(i RANGE ${first} ${last} 2)
    string(SUBSTRING "${hex}" ${i} 2 byte)
    math(EXPR v "0x${byte}")
    math(EXPR sum "${sum} + ${v}")
    if(v GREATER max)
      set(max ${v})
    endif()
  endforeach()
  set(${out_sum} ${sum} PARENT_SCOPE)
  set(${out_max} ${max} PARENT_SCOPE)
endfunction()

foreach(t 0.3 1.2 1.98 2.08 2.3 3.5 6.0)
  string(REPLACE "." "_" tag "${t}")
  shot(t${tag} --lab 1 --screen menu --wake-t ${t})
endforeach()
shot(t3_5_again --lab 1 --screen menu --wake-t 3.5)
shot(plain --lab 1 --screen menu)
shot(nowake --lab 1 --screen menu --wake 0 --wake-t 1.2)
shot(off_plain --lab 0 --screen menu)
shot(off_wake --lab 0 --screen menu --wake-t 1.2)
shot(handshake --lab 1 --screen menu --handshake-t 0.5)

set(names t0_3 t1_2 t1_98 t2_08 t2_3 t3_5 t6_0)
foreach(a IN LISTS names)
  foreach(b IN LISTS names)
    if(NOT a STREQUAL b AND hash_${a} STREQUAL hash_${b})
      message(FATAL_ERROR "wake captures ${a} and ${b} are identical")
    endif()
  endforeach()
endforeach()
if(NOT hash_t3_5 STREQUAL hash_t3_5_again)
  message(FATAL_ERROR "the same wake age rendered twice differs")
endif()
if(NOT hash_t6_0 STREQUAL hash_plain)
  message(FATAL_ERROR "a finished wake is not the settled menu")
endif()
if(NOT hash_nowake STREQUAL hash_plain)
  message(FATAL_ERROR "--wake 0 still changes the frame")
endif()
if(NOT hash_off_plain STREQUAL hash_off_wake)
  message(FATAL_ERROR "--lab 0 launch differs when a wake age is given")
endif()
# The handshake alone starts at wake age 3.0, so --handshake-t 0.5 is --wake-t 3.5.
if(NOT hash_handshake STREQUAL hash_t3_5 OR hash_handshake STREQUAL hash_t6_0)
  message(FATAL_ERROR "--handshake-t 0.5 is not the wake at 3.5 s")
endif()

# A shut eyelid (blink 1 is closed at 2.08 s) leaves rows 0.4 H .. 0.55 H pure black.
math(EXPR y0 "${H} * 40 / 100")
math(EXPR y1 "${H} * 55 / 100 + 1")
rows("${OUT_DIR}/wake/t2_08.ppm" ${y0} ${y1} shutSum shutMax)
if(NOT shutMax EQUAL 0)
  message(FATAL_ERROR "rows ${y0}..${y1} of the shut eyelid are not black (max ${shutMax})")
endif()
# Eyes closed at the start: dim, but a warm glow comes through (mean over the frame).
rows("${OUT_DIR}/wake/t0_3.ppm" 0 ${H} glowSum glowMax)
math(EXPR bytes "${W} * ${H} * 3")
math(EXPR meanTimes1000 "${glowSum} * 1000 / ${bytes}")
if(glowSum EQUAL 0)
  message(FATAL_ERROR "the glow through closed lids is invisible")
endif()
# 0.05 * 255 = 12.75 -> mean x 1000 below 12750
if(meanTimes1000 GREATER 12750)
  message(FATAL_ERROR "the closed-eye frame is too bright: mean x1000 ${meanTimes1000}")
endif()
