file(MAKE_DIRECTORY "${OUT_DIR}/neural")
set(common standard --theme manifold --lab 1 --width 640 --height 360 --heartbeat 0)
function(shot name)
  execute_process(COMMAND "${GUI}" ${common} ${ARGN}
    --shot "${OUT_DIR}/neural/${name}.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name}: ${err}")
  endif()
  file(SHA256 "${OUT_DIR}/neural/${name}.ppm" hash)
  set(hash_${name} ${hash} PARENT_SCOPE)
endfunction()
foreach(screen menu welcome newgame watch settings quit editor designer body flat
               identity castling marks fields rules pause pausequit info pieces board)
  shot(${screen}-form --screen ${screen} --panel-t 0.10)
  shot(${screen}-settled --screen ${screen} --panel-t 0.60)
  if(hash_${screen}-form STREQUAL hash_${screen}-settled)
    message(FATAL_ERROR "${screen} bypassed the implant form")
  endif()
endforeach()
shot(calm --screen pause --presentation 0 --heartbeat 0)
shot(calm-pulse --screen pause --presentation 0 --heartbeat 1)
if(NOT hash_calm STREQUAL hash_calm-pulse)
  message(FATAL_ERROR "calm heartbeat is not disabled")
endif()
shot(beat --screen pause --visual-time 0 --heartbeat 1)
shot(beat-again --screen pause --visual-time 0 --heartbeat 1)
shot(rest --screen pause --visual-time 0.5 --heartbeat 1)
if(NOT hash_beat STREQUAL hash_beat-again OR hash_beat STREQUAL hash_rest)
  message(FATAL_ERROR "heartbeat is not deterministic and visible on pause")
endif()
