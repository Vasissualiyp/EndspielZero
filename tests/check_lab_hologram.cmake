file(MAKE_DIRECTORY "${OUT_DIR}/lab-hologram")
set(common standard --theme manifold --lab 1 --width 640 --height 360)
function(shot name)
  execute_process(COMMAND ${CMAKE_COMMAND} -E env
    "XDG_CONFIG_HOME=${OUT_DIR}/lab-hologram/config" "${GUI}" ${common} ${ARGN}
    --shot "${OUT_DIR}/lab-hologram/${name}.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name} failed: ${err}")
  endif()
  file(SHA256 "${OUT_DIR}/lab-hologram/${name}.ppm" hash)
  set(hash_${name} ${hash} PARENT_SCOPE)
endfunction()
shot(menu --screen menu --projector 1)
shot(off --screen menu --projector 0)
shot(repeat --screen menu --projector 1)
if(hash_menu STREQUAL hash_off OR NOT hash_menu STREQUAL hash_repeat)
  message(FATAL_ERROR "projector toggle has no effect or is nondeterministic")
endif()
shot(settings --screen settings --projector 1)
shot(settings-off --screen settings --projector 0)
if(hash_settings STREQUAL hash_settings-off)
  message(FATAL_ERROR "lab settings does not project its tesseract")
endif()
shot(flat --screen newgame --overture-t 0)
shot(formed --screen newgame --overture-t 1)
shot(alias --screen newgame --t 1)
if(hash_flat STREQUAL hash_formed OR NOT hash_alias STREQUAL hash_formed)
  message(FATAL_ERROR "overture progress or --t alias does not work")
endif()
shot(legacy --lab 0 --screen menu --projector 1)
shot(legacy-off --lab 0 --screen menu --projector 0)
if(NOT hash_legacy STREQUAL hash_legacy-off)
  message(FATAL_ERROR "projector changed the lab-off path")
endif()
foreach(args "--projector;2" "--projector" "--overture-t;nan" "--overture-t;-0.1" "--overture-t;1.1" "--overture-t;junk" "--overture-t")
  execute_process(COMMAND "${GUI}" ${common} ${args} --shot "${OUT_DIR}/lab-hologram/invalid.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
  if(rc EQUAL 0)
    message(FATAL_ERROR "invalid projector flags accepted: ${args}")
  endif()
endforeach()
