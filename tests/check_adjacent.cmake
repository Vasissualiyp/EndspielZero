# M22.2 the tiled view: a capture at a fixed reveal reproduces byte for byte, draws
# something the plain board does not, and is ignored on the shape (already cyclic).
file(MAKE_DIRECTORY "${OUT_DIR}/adjacent")
set(common torus --width 480 --height 270)
function(shot name)
  execute_process(COMMAND "${GUI}" ${common} ${ARGN}
    --shot "${OUT_DIR}/adjacent/${name}.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name} capture failed: ${err}")
  endif()
  file(SHA256 "${OUT_DIR}/adjacent/${name}.ppm" h)
  set(hash_${name} ${h} PARENT_SCOPE)
endfunction()

shot(off)
shot(on-a --adjacent --adjacent-amount 0.6)
shot(on-b --adjacent --adjacent-amount 0.6)
if(NOT hash_on-a STREQUAL hash_on-b)
  message(FATAL_ERROR "the tiled view at a fixed amount is not reproducible")
endif()
if(hash_on-a STREQUAL hash_off)
  message(FATAL_ERROR "the tiled view drew nothing")
endif()
# The ADJ button is lit while the switch is on (M22.3), so the board alone is compared:
# `--cinema` draws no interface.
shot(off-board --cinema)
shot(zero --cinema --adjacent --adjacent-amount 0)
if(NOT hash_zero STREQUAL hash_off-board)
  message(FATAL_ERROR "the tiled view at amount 0 is not the plain board")
endif()
shot(lit --adjacent)
if(hash_lit STREQUAL hash_off)
  message(FATAL_ERROR "the ADJ button does not light with the switch on")
endif()
shot(flat --flat)
shot(flat-on --flat --adjacent)
if(hash_flat-on STREQUAL hash_flat)
  message(FATAL_ERROR "the flat tiled view drew nothing")
endif()
shot(shape --geometry)
shot(shape-on --geometry --adjacent)
if(NOT hash_shape-on STREQUAL hash_shape)
  message(FATAL_ERROR "the tiled view leaked onto the shape")
endif()
shot(lab --theme manifold --lab 1)
shot(lab-on --theme manifold --lab 1 --adjacent)
if(hash_lab-on STREQUAL hash_lab)
  message(FATAL_ERROR "the tiled view drew nothing in the lab")
endif()
shot(vr --theme manifold --lab 1 --vr 1)
shot(vr-on --theme manifold --lab 1 --vr 1 --adjacent)
if(hash_vr-on STREQUAL hash_vr)
  message(FATAL_ERROR "the tiled view drew nothing in neural VR")
endif()
# M22.5 hover: the copy under the pointer answers it, faintly - a capture with the pointer
# on a copy differs from one on the board's own cell, in the plain view, the lab and
# neural VR alike.
shot(hover-centre --cinema --adjacent --script "hover b2")
shot(hover-copy --cinema --adjacent --script "hover b2 copy 1 0")
shot(hover-copy-b --cinema --adjacent --script "hover b2 copy 1 0")
if(hash_hover-copy STREQUAL hash_hover-centre)
  message(FATAL_ERROR "hovering a copy marks nothing on the copy")
endif()
if(NOT hash_hover-copy STREQUAL hash_hover-copy-b)
  message(FATAL_ERROR "the copy hover is not reproducible")
endif()
shot(hover-flat --cinema --flat --adjacent --script "hover b2")
shot(hover-flat-copy --cinema --flat --adjacent --script "hover b2 copy 1 0")
if(hash_hover-flat-copy STREQUAL hash_hover-flat)
  message(FATAL_ERROR "hovering a copy marks nothing on the flat copy")
endif()
shot(hover-lab --theme manifold --lab 1 --adjacent --script "hover b2")
shot(hover-lab-copy --theme manifold --lab 1 --adjacent --script "hover b2 copy 1 0")
if(hash_hover-lab-copy STREQUAL hash_hover-lab)
  message(FATAL_ERROR "hovering a copy marks nothing in the lab")
endif()
shot(hover-vr --theme manifold --lab 1 --vr 1 --adjacent --script "hover b2")
shot(hover-vr-copy --theme manifold --lab 1 --vr 1 --adjacent --script "hover b2 copy 1 0")
if(hash_hover-vr-copy STREQUAL hash_hover-vr)
  message(FATAL_ERROR "hovering a copy marks nothing in neural VR")
endif()
# M22.4 the arrival: a copy half-way in is somewhere else than an arrived one (and still
# reproduces), in the plain view, flat, the lab and neural VR alike.
shot(arrived --cinema --adjacent --adjacent-amount 1)
shot(arriving --cinema --adjacent --adjacent-amount 0.4)
shot(arriving-b --cinema --adjacent --adjacent-amount 0.4)
if(hash_arriving STREQUAL hash_arrived)
  message(FATAL_ERROR "the copies do not move on their way in")
endif()
if(NOT hash_arriving STREQUAL hash_arriving-b)
  message(FATAL_ERROR "the arrival at a fixed amount is not reproducible")
endif()
foreach(view "flat;--flat" "lab;--theme;manifold;--lab;1" "vr;--theme;manifold;--lab;1;--vr;1")
  list(POP_FRONT view tag)
  shot(${tag}-arrived --cinema ${view} --adjacent --adjacent-amount 1)
  shot(${tag}-arriving --cinema ${view} --adjacent --adjacent-amount 0.4)
  if(hash_${tag}-arriving STREQUAL hash_${tag}-arrived)
    message(FATAL_ERROR "the copies do not move on their way in (${tag})")
  endif()
endforeach()
