# Compare the same board with and without its material at a fixed resolution.
foreach(style wood matte)
  set(out "${OUT_DIR}/${style}.ppm")
  if(style STREQUAL "matte")
    set(flags --matte)
  else()
    set(flags)
  endif()
  execute_process(COMMAND "${GUI}" standard --width 640 --height 360
                          --shot "${out}" --post 0 ${flags}
                  WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc
                  OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${style} capture failed: ${err}")
  endif()
  file(READ "${out}" ${style} HEX)
endforeach()

set(prefix "P6\n640 360\n255\n")
string(LENGTH "${prefix}" offset)
set(sumwood 0)
set(summatte 0)
set(edgewood 0)
set(edgematte 0)
set(samples 0)
# Sample the middle 40% of the frame. The same positions and neighbours are read
# for both looks; stepping by four keeps CMake's hex-string decoding inexpensive.
foreach(y RANGE 108 252 4)
  foreach(x RANGE 192 448 4)
    foreach(style wood matte)
      foreach(dx 0 1)
        math(EXPR byte "((${y} * 640 + ${x} - ${dx}) * 3 + ${offset}) * 2")
        set(lum 0)
        foreach(channel 0 1 2)
          math(EXPR at "${byte} + ${channel} * 2")
          string(SUBSTRING "${${style}}" ${at} 2 hex)
          math(EXPR value "0x${hex}")
          if(channel EQUAL 0)
            math(EXPR lum "${lum} + 299 * ${value}")
          elseif(channel EQUAL 1)
            math(EXPR lum "${lum} + 587 * ${value}")
          else()
            math(EXPR lum "${lum} + 114 * ${value}")
          endif()
        endforeach()
        math(EXPR lum "${lum} / 1000")
        if(dx EQUAL 0)
          set(current ${lum})
        else()
          math(EXPR delta "${current} - ${lum}")
          if(delta LESS 0)
            math(EXPR delta "0 - ${delta}")
          endif()
          math(EXPR edge${style} "${edge${style}} + ${delta}")
        endif()
      endforeach()
      math(EXPR sum${style} "${sum${style}} + ${current}")
    endforeach()
    math(EXPR samples "${samples} + 1")
  endforeach()
endforeach()
math(EXPR meanWood "${sumwood} / ${samples}")
math(EXPR meanMatte "${summatte} / ${samples}")
math(EXPR difference "${meanWood} - ${meanMatte}")
if(difference LESS 0)
  math(EXPR difference "0 - ${difference}")
endif()
math(EXPR tolerance "${meanMatte} * 8 / 100")
if(difference GREATER tolerance)
  message(FATAL_ERROR "wood repaints the board: ${meanWood} vs matte ${meanMatte}")
endif()
math(EXPR minimum "${edgematte} * 13 / 10")
if(edgewood LESS minimum)
  message(FATAL_ERROR "wood grain is not visible: ${edgewood} vs matte ${edgematte}")
endif()
message(STATUS "wood mean ${meanWood}, matte ${meanMatte}; neighbour differences ${edgewood}/${edgematte}")
