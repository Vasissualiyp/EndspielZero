file(MAKE_DIRECTORY "${OUT_DIR}/lab-room")
set(common standard --theme manifold --screen menu --width 640 --height 360)
function(shot name)
  execute_process(COMMAND ${CMAKE_COMMAND} -E env
    "XDG_CONFIG_HOME=${OUT_DIR}/lab-room/config" "${GUI}" ${common} ${ARGN}
    --shot "${OUT_DIR}/lab-room/${name}.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name} failed: ${err}")
  endif()
  file(SHA256 "${OUT_DIR}/lab-room/${name}.ppm" hash)
  set(hash_${name} ${hash} PARENT_SCOPE)
endfunction()
shot(default)
shot(off --lab 0)
shot(on --lab 1)
shot(quit --lab 1 --station quit)
if(NOT hash_default STREQUAL hash_off)
  message(FATAL_ERROR "lab off changed default captures")
endif()
if(hash_on STREQUAL hash_off)
  message(FATAL_ERROR "lab on has no effect")
endif()
# A saved preference must not opt a capture in, even with --user-settings.
file(MAKE_DIRECTORY "${OUT_DIR}/lab-room/config/endspielzero")
file(WRITE "${OUT_DIR}/lab-room/config/endspielzero/settings.conf" "lab_scene = true\n")
shot(saved-default --user-settings)
shot(saved-off --user-settings --lab 0)
shot(saved-on --user-settings --lab 1)
if(NOT hash_saved-default STREQUAL hash_saved-off OR hash_saved-on STREQUAL hash_saved-off)
  message(FATAL_ERROR "saved lab setting overrode capture defaults or CLI override")
endif()
foreach(args "--station;menu" "--lab;0;--station;menu" "--lab;1;--station;unknown" "--lab;2")
  execute_process(COMMAND "${GUI}" ${common} ${args} --shot "${OUT_DIR}/lab-room/invalid.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
  if(rc EQUAL 0)
    message(FATAL_ERROR "invalid lab flags accepted: ${args}")
  endif()
endforeach()
shot(station-board --lab 1 --station menu --screen board)
shot(station-board-off --lab 0 --screen board)
if(hash_station-board STREQUAL hash_station-board-off)
  message(FATAL_ERROR "--station did not override the board screen")
endif()
