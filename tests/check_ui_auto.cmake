# Automatic sizing is opt-in for captures; exact scale wins in either flag order.
file(MAKE_DIRECTORY "${OUT_DIR}/ui-auto")
set(common standard --theme manifold --width 1920 --height 1080)
foreach(mode default exact auto expected-auto exact-wins auto-last)
  set(flags)
  if(mode STREQUAL "exact")
    set(flags --ui-scale 1)
  elseif(mode STREQUAL "auto")
    set(flags --ui-auto)
  elseif(mode STREQUAL "expected-auto")
    set(flags --ui-scale 1.5)
  elseif(mode STREQUAL "exact-wins")
    set(flags --ui-auto --ui-scale 1)
  elseif(mode STREQUAL "auto-last")
    set(flags --ui-scale 1 --ui-auto)
  endif()
  execute_process(COMMAND "${GUI}" ${common} ${flags} --shot "${OUT_DIR}/ui-auto/${mode}.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${mode} capture failed: ${err}")
  endif()
  file(SHA256 "${OUT_DIR}/ui-auto/${mode}.ppm" hash_${mode})
endforeach()
if(NOT hash_default STREQUAL hash_exact OR NOT hash_default STREQUAL hash_exact-wins
   OR NOT hash_default STREQUAL hash_auto-last)
  message(FATAL_ERROR "default/exact scaling changed or --ui-auto beat an explicit scale")
endif()
if(NOT hash_auto STREQUAL hash_expected-auto OR hash_auto STREQUAL hash_default)
  message(FATAL_ERROR "--ui-auto did not select 1.5x at 1080p")
endif()
