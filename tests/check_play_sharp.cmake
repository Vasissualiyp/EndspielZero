# M25.7: the board is never defocused while a game is played (any gaze, daydream or uniform
# defocus input leaves the frame as it was), and the main menu still blurs.
file(MAKE_DIRECTORY "${OUT_DIR}/play_sharp")
function(shot name)
  execute_process(COMMAND "${GUI}" --theme manifold --width 480 --height 270 ${ARGN}
    --shot "${OUT_DIR}/play_sharp/${name}.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name} capture failed: ${err}")
  endif()
  # The board's own pixels: the middle of the frame, clear of the implant's softened edge
  # chrome (rows 60..209, columns 60..419 of a 480x270 P6 capture, 15 header bytes).
  file(READ "${OUT_DIR}/play_sharp/${name}.ppm" hex HEX)
  set(core "")
  foreach(row RANGE 60 209)
    math(EXPR start "(15 + (${row} * 480 + 60) * 3) * 2")
    string(SUBSTRING "${hex}" ${start} 2160 line)
    string(APPEND core "${line}")
  endforeach()
  set(core_${name} "${core}" PARENT_SCOPE)
endfunction()
# Pixels that differ by more than two levels between two cores (the implant composite
# rounds the sharp frame by one level either way; a defocused board moves thousands).
function(differing a b out)
  string(LENGTH "${a}" n)
  math(EXPR last "${n} / 6 - 1")
  set(count 0)
  foreach(i RANGE ${last})
    math(EXPR at "${i} * 6")
    string(SUBSTRING "${a}" ${at} 6 pa)
    string(SUBSTRING "${b}" ${at} 6 pb)
    if(NOT pa STREQUAL pb)
      foreach(c 0 2 4)
        string(SUBSTRING "${pa}" ${c} 2 xa)
        string(SUBSTRING "${pb}" ${c} 2 xb)
        math(EXPR d "0x${xa} - 0x${xb}")
        if(d GREATER 2 OR d LESS -2)
          math(EXPR count "${count} + 1")
          break()
        endif()
      endforeach()
    endif()
  endforeach()
  set(${out} ${count} PARENT_SCOPE)
endfunction()
# The board alone (no interface): the lens warp is the view's, but no gaze, daydream or
# uniform defocus may reach it, so the daydream and gaze-target inputs equal the plain awake frame. (A gaze on the
# interface also dims the room's tone; that is not a defocus and is not tested here.)
foreach(variant standard torus)
  set(g ${variant} --lab 1 --cinema)
  shot(${variant}_awake ${g} --living 1 --gaze-ui 0)
  shot(${variant}_daydream ${g} --living 1 --gaze-ui 0 --daydream-t 14)
  shot(${variant}_lamp ${g} --living 1 --gaze-target lamp)
  foreach(other daydream lamp)
    differing("${core_${variant}_${other}}" "${core_${variant}_awake}" n)
    message(STATUS "${variant} ${other}: ${n} differing pixels")
    if(n GREATER 100)
      message(FATAL_ERROR "${variant}: the board changed with ${other} vision in play")
    endif()
  endforeach()
endforeach()
# The main menu keeps its defocus.
shot(menu_calm --lab 1 --screen menu --living 0)
shot(menu_daydream --lab 1 --screen menu --living 1 --daydream-t 14)
differing("${core_menu_calm}" "${core_menu_daydream}" n)
message(STATUS "menu daydream: ${n} differing pixels")
if(n LESS 1000)
  message(FATAL_ERROR "the main menu no longer defocuses")
endif()
