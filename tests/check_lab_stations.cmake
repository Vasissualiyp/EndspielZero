file(MAKE_DIRECTORY "${OUT_DIR}/lab-stations")
set(common standard --theme manifold --lab 1 --width 960 --height 540 --ui-auto)
function(shot name)
  execute_process(COMMAND "${GUI}" ${common} ${ARGN}
    --shot "${OUT_DIR}/lab-stations/${name}.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name} capture failed: ${err}")
  endif()
  file(SHA256 "${OUT_DIR}/lab-stations/${name}.ppm" h)
  set(hash_${name} ${h} PARENT_SCOPE)
endfunction()
function(stations name from to)
  shot(${name}-from --screen ${from})
  shot(${name}-cut --screen ${to})
  shot(${name}-end --screen ${to} --from ${from} --transition-t 5)
  shot(${name}-mid --screen ${to} --from ${from} --transition-t 0.3)
  shot(${name}-calm --screen ${to} --from ${from} --transition-t 0.4 --presentation 0)
  shot(${name}-calm-cut --screen ${to} --presentation 0)
  if(NOT hash_${name}-end STREQUAL hash_${name}-cut)
    message(FATAL_ERROR "${name}: finished Station move differs from destination")
  endif()
  if(hash_${name}-mid STREQUAL hash_${name}-cut OR hash_${name}-mid STREQUAL hash_${name}-from)
    message(FATAL_ERROR "${name}: intermediate Station frame equals an endpoint")
  endif()
  if(NOT hash_${name}-calm STREQUAL hash_${name}-calm-cut)
    message(FATAL_ERROR "${name}: calm move has not settled")
  endif()
endfunction()
stations(menu-editor menu editor)
stations(editor-menu editor menu)
stations(menu-library menu newgame)
stations(library-menu newgame menu)
stations(menu-settings menu settings)
stations(menu-quit menu quit)
stations(quit-menu quit menu)

# A Library subject pin must not accidentally turn a transition back to menu into
# the old --t trailer capture.
shot(pinned-library-end --screen menu --from newgame --transition-t 5 --overture-t 0.7)
shot(plain-menu --screen menu)
if(NOT hash_pinned-library-end STREQUAL hash_plain-menu)
  message(FATAL_ERROR "Library subject pin started the trailer during a station preview")
endif()
