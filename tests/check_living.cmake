# M24.4c: living vision changes the lab menu, the gaze changes focus, captures are
# deterministic, and the lab-off frame never sees any of it.
file(MAKE_DIRECTORY "${OUT_DIR}/living")
function(shot name)
  execute_process(COMMAND "${GUI}" --theme manifold --width 480 --height 270 ${ARGN}
    --shot "${OUT_DIR}/living/${name}.ppm"
    WORKING_DIRECTORY "${WORKDIR}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "${name} capture failed: ${err}")
  endif()
  file(SHA256 "${OUT_DIR}/living/${name}.ppm" h)
  set(hash_${name} ${h} PARENT_SCOPE)
endfunction()
shot(on --lab 1 --screen menu --living 1)
shot(on_again --lab 1 --screen menu --living 1)
shot(off --lab 1 --screen menu --living 0)
shot(room --lab 1 --screen menu --living 1 --gaze-ui 0)
shot(reading --lab 1 --screen menu --living 1 --gaze-ui 1)
shot(lamp --lab 1 --screen menu --living 1 --gaze-target lamp)
shot(lab_off_on --lab 0 --screen menu --living 1)
shot(lab_off_off --lab 0 --screen menu --living 0)
if(hash_on STREQUAL hash_off)
  message(FATAL_ERROR "--living 1 equals --living 0 on the lab menu")
endif()
if(NOT hash_on STREQUAL hash_on_again)
  message(FATAL_ERROR "two living captures differ: tremor and wander must be off")
endif()
if(hash_room STREQUAL hash_reading)
  message(FATAL_ERROR "--gaze-ui 0 equals --gaze-ui 1")
endif()
if(hash_lamp STREQUAL hash_reading)
  message(FATAL_ERROR "--gaze-target lamp equals the reading gaze")
endif()
if(NOT hash_lab_off_on STREQUAL hash_lab_off_off)
  message(FATAL_ERROR "--lab 0 differs with --living 1")
endif()
